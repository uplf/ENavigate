[Unit]
Description=AGV HTTP Capture API — FCGI endpoint serving /api/capture
After=agv-model-manager.service agv-log-daemon.service
Requires=agv-log-daemon.service

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/opt/enavigate-master/build/src/http_service/Capture
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agv-http-capture
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
