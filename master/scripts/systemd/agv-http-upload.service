[Unit]
Description=AGV HTTP Upload API — FCGI endpoint serving /api/upload_image (called by ESP32 cars)
After=agv-model-manager.service agv-log-daemon.service
Requires=agv-log-daemon.service

[Service]
Type=simple
User=www-data
Group=www-data
ExecStartPre=/bin/mkdir -p /var/agv/captures
ExecStart=/opt/enavigate-master/build/src/http_service/Upload
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agv-http-upload
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
